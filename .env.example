# =============================================================================
# AI Career & Opportunity Matcher — Environment Template
#
# Quickstart:  cp .env.example .env   then replace every "REPLACE_ME" value.
#
# Server-side keys (Stack secret, Gemini, Pinecone, Neon DATABASE_URL) MUST NOT
# be exposed to the browser. Only VITE_* variables reach the frontend bundle.
# =============================================================================

# --- Auth: Neon Auth (@neondatabase/neon-js) -------------------------------
# 1. Enable Neon Auth in the Neon Console (Project → Auth tab).
#    This provisions the neon_auth.users_sync table our schema FKs target.
# 2. The Quickstart panel shows ONE env var: VITE_NEON_AUTH_URL.
#    Copy it and paste below. (No project id / publishable key / secret key —
#    that was the older Stack Auth flow; the new neon-js SDK uses one URL.)
# Docs: https://neon.tech/docs/guides/neon-auth
#
# Format: https://<endpoint>.neonauth.<region>.aws.neon.tech/<dbname>/auth
VITE_NEON_AUTH_URL=https://REPLACE_ME.neonauth.us-east-1.aws.neon.tech/neondb/auth

# --- Database: Neon Postgres ----------------------------------------------
# Use the POOLED connection string from the Neon dashboard (Connect → Pooled).
# Same DB hosts both your app schema (public) and neon_auth.users_sync.
# Format: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-REPLACE_ME-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Vector Database: Pinecone --------------------------------------------
# Create a serverless index, dim 768, metric cosine, name "careers-mvp".
# API key prefix: pcsk_
# Get it from: https://app.pinecone.io/  →  API Keys
PINECONE_API_KEY=pcsk_REPLACE_ME
PINECONE_INDEX=careers-mvp
# Optional: explicit host (only set if you don't want the SDK to auto-discover)
# PINECONE_HOST=careers-mvp-xxxxxxx.svc.aped-xxxx-xxxx.pinecone.io

# --- AI: Google Gemini ----------------------------------------------------
# Get a key from https://aistudio.google.com/  →  Get API Key
# API key prefix: AIza   (~39 chars)
GEMINI_API_KEY=AIzaSy-REPLACE_ME
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional: truncate gemini-embedding-001's 3072-dim output via Matryoshka.
# Set this to match your Pinecone index dimension (e.g. 1024 or 768).
# GEMINI_EMBED_DIM=1024

# --- Server runtime --------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Daily kill-switch / abuse cap (USD est.; integer dollars).
# When today's estimated AI cost exceeds this, the AI generation routes return 503.
AI_DAILY_BUDGET_USD=10

# --- Frontend (Vite) -------------------------------------------------------
# Vite reads VITE_* from this file at dev/build time.
VITE_API_BASE_URL=http://localhost:4000
